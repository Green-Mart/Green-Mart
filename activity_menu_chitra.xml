<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fresh Picks Just for You"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:layout_alignParentTop="true" />

    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What do you want to order?"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:background="@android:drawable/editbox_background" />

    <TextView
        android:id="@+id/menu_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_below="@id/search_bar"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@id/menu_label"
        android:layout_marginTop="5dp"
        android:fillViewport="true"/>

    <LinearLayout
        android:id="@+id/menu_items_container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        android:background="#F8F8F8"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/green_plant"/>

        <LinearLayout
            android:layout_width="2dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Onion"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$70"
                android:textColor="#4CAF50"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/add_to_cart1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4CAF50"
            android:text="Add to Cart"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:background="#F8F8F8"
        android:elevation="2dp"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/green_plant"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="2dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apple"
                android:textSize="16sp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$50"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/add_to_cart2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to Cart"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:background="#F8F8F8"
        android:elevation="2dp"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/green_plant"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="2dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_height="match_parent"
                android:layout_width="wrap_content"
                android:text="Milk"
                android:textSize="16sp"
                android:textColor="#000000" />

            <TextView
                android:layout_height="match_parent"
                android:layout_width="wrap_content"
                android:text="$25"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/add_to_cart3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to Cart"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>